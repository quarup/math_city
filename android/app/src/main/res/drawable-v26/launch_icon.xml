<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ launch-screen icon. A plain bitmap would be wrapped in a
     pale disc by the system, so this is an adaptive icon whose background
     is the launch screen's own sky: the disc is there but invisible. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launch_sky"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
